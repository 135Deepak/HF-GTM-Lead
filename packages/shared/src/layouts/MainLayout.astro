---
import "../styles/global.css";
import "../styles/responsive.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  landingUrl?: string;
  socialScoreUrl?: string;
  leadUrl?: string;
}

const isDev = import.meta.env.DEV;
const defaultLanding = isDev ? "http://localhost:4321" : (import.meta.env.PUBLIC_LANDING_URL || "/");
const defaultSocial = isDev ? "http://localhost:4322" : (import.meta.env.PUBLIC_SOCIAL_SCORE_URL || "/social-score");
const defaultLead = isDev ? "http://localhost:4323" : (import.meta.env.PUBLIC_LEAD_URL || "/lead");

const {
  title = "HealthFoundry — Intelligent Healthcare Growth Tools",
  description = "Operational intelligence tools for healthcare organizations — benchmark your social media presence in 3 minutes, or connect with our growth specialists.",
  currentPath = Astro.url.pathname,
  landingUrl = defaultLanding,
  socialScoreUrl = defaultSocial,
  leadUrl = defaultLead
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo-mark.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Martian+Mono:wdth,wght@75..112.5,400..700&display=swap" />
    <script is:inline>
      (function () {
        try {
          var theme = null;
          // 1. Query parameter (?theme=dark or ?theme=light)
          var params = new URLSearchParams(window.location.search);
          var qTheme = params.get("theme");
          if (qTheme === "dark" || qTheme === "light") {
            theme = qTheme;
          }
          // 2. Cookie (shared across localhost ports and domain)
          if (!theme) {
            var match = document.cookie.match(/(?:^|;\s*)hf-theme=([^;]+)/);
            if (match && (match[1] === "dark" || match[1] === "light")) {
              theme = match[1];
            }
          }
          // 3. LocalStorage for this origin
          if (!theme) {
            var saved = localStorage.getItem("hf-theme");
            if (saved === "dark" || saved === "light") {
              theme = saved;
            }
          }
          // 4. OS preference
          if (!theme && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          }

          if (theme === "dark") {
            document.documentElement.classList.add("dark");
          } else if (theme === "light") {
            document.documentElement.classList.remove("dark");
          }

          if (theme) {
            localStorage.setItem("hf-theme", theme);
            document.cookie = "hf-theme=" + theme + "; path=/; max-age=31536000; SameSite=Lax";
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <IconSprite />
    <Header
      currentPath={currentPath}
      landingUrl={landingUrl}
      socialScoreUrl={socialScoreUrl}
      leadUrl={leadUrl}
    />
    <main>
      <slot />
    </main>
    <Footer
      landingUrl={landingUrl}
      socialScoreUrl={socialScoreUrl}
      leadUrl={leadUrl}
    />

    <script is:inline>
      (function() {
        function getActiveTheme() {
          return document.documentElement.classList.contains("dark") ? "dark" : "light";
        }

        function setGlobalTheme(theme) {
          if (theme === "dark") {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
          try {
            localStorage.setItem("hf-theme", theme);
            document.cookie = "hf-theme=" + theme + "; path=/; max-age=31536000; SameSite=Lax";
          } catch (e) {}
          updateCrossAppLinks(theme);
        }

        function updateCrossAppLinks(theme) {
          var currentTheme = theme || getActiveTheme();
          var links = document.querySelectorAll("a[href]");
          for (var i = 0; i < links.length; i++) {
            var link = links[i];
            try {
              var rawHref = link.getAttribute("href");
              if (!rawHref || rawHref.startsWith("#") || rawHref.startsWith("javascript:") || rawHref.startsWith("mailto:")) continue;
              var url = new URL(link.href, window.location.href);
              var isAppPort = ["4321", "4322", "4323"].indexOf(url.port) !== -1;
              var isAppDomain = url.hostname.indexOf("healthfoundry") !== -1 || url.hostname.indexOf("workers.dev") !== -1;
              var isLocalSameHost = url.hostname === window.location.hostname;
              if (isAppPort || (isLocalSameHost && (url.pathname === "/" || url.pathname.indexOf("/social-score") === 0 || url.pathname.indexOf("/lead") === 0)) || isAppDomain) {
                url.searchParams.set("theme", currentTheme);
                link.href = url.toString();
              }
            } catch (err) {}
          }
        }

        var toggle = document.getElementById("themeToggle");
        if (toggle) {
          toggle.addEventListener("click", function() {
            var nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
            setGlobalTheme(nextTheme);
          });
        }

        window.addEventListener("storage", function(e) {
          if (e.key === "hf-theme" && (e.newValue === "dark" || e.newValue === "light")) {
            setGlobalTheme(e.newValue);
          }
        });

        window.addEventListener("pageshow", function() {
          try {
            var theme = null;
            var match = document.cookie.match(/(?:^|;\s*)hf-theme=([^;]+)/);
            if (match && (match[1] === "dark" || match[1] === "light")) {
              theme = match[1];
            }
            if (!theme) {
              theme = localStorage.getItem("hf-theme");
            }
            if (theme) {
              setGlobalTheme(theme);
            } else {
              updateCrossAppLinks();
            }
          } catch (err) {
            updateCrossAppLinks();
          }
        });

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function() { updateCrossAppLinks(); });
        } else {
          updateCrossAppLinks();
        }
      })();
    </script>
  </body>
</html>
