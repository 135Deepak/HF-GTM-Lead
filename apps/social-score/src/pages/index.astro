---
import MainLayout from "@hf/shared/layouts/MainLayout.astro";
import { SocialScoreAssessment } from "../components/SocialScoreAssessment";

const isDev = import.meta.env.DEV;
const landingUrl = isDev ? "http://localhost:4321" : (import.meta.env.PUBLIC_LANDING_URL || "/");
const socialScoreUrl = isDev ? "http://localhost:4322" : (import.meta.env.PUBLIC_SOCIAL_SCORE_URL || "/social-score");
const leadUrl = isDev ? "http://localhost:4323" : (import.meta.env.PUBLIC_LEAD_URL || "/lead");
---

<MainLayout
  title="Healthcare Social Media Index — HealthFoundry"
  currentPath="/social-score"
  landingUrl={landingUrl}
  socialScoreUrl={socialScoreUrl}
  leadUrl={leadUrl}
>
  <section class="view active" data-view="/social-score">
    <div class="page-band sky grid-surface">
      <div class="sky-drift page-band-drift" aria-hidden="true">
        <div class="drifter pb-d1"><svg viewBox="0 0 3 3" shape-rendering="crispEdges" fill="currentColor"><rect x="1" y="0" width="1" height="3"/><rect x="0" y="1" width="3" height="1"/></svg></div>
        <div class="drifter pb-d2"><svg viewBox="0 0 3 3" shape-rendering="crispEdges" fill="currentColor"><rect x="1" y="0" width="1" height="3"/><rect x="0" y="1" width="3" height="1"/></svg></div>
      </div>
      <div class="page-band-inner">
        <a href={landingUrl} class="back" aria-label="Back to Home"><svg><use href="#i-arrowLeft"/></svg>Back to Home</a>
        <div class="hf-overline" style="margin-bottom:12px">self-assessment · 3 min</div>
        <h1>Know your social media score</h1>
        <p>Three quick questions. Your score is calculated in your browser.</p>
      </div>
      <div class="horizon"></div>
    </div>

    <div class="gtm-container tool-wrap">
      <div class="tool-layout">
        <SocialScoreAssessment client:load />

        <aside class="tool-aside panel">
          <div class="panel-body">
            <div class="hf-overline">What we evaluate</div>
            <ul class="aside-list">
              <li><svg><use href="#i-check"/></svg>Channel footprint and profile completeness</li>
              <li><svg><use href="#i-check"/></svg>Clinical publishing cadence and content mix</li>
              <li><svg><use href="#i-check"/></svg>Patient engagement and community responsiveness</li>
              <li><svg><use href="#i-check"/></svg>Appointment conversion and referral attribution</li>
            </ul>
            <div class="callout"><svg><use href="#i-alert"/></svg><span>Part of HealthFoundry's Vital360 patient growth diagnostic suite. Scores calibrated to healthcare peer benchmarks.</span></div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</MainLayout>
