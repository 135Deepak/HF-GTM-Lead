{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "healthfoundry-landing",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"GOOGLE_SHEETS_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxOf-p9TEq4JiwJBKBj0an_JY7-NO7bQMejZzNhMhqU2ieLGNQEL9_o60p4Ia--9aVT/exec"
	},
	"observability": {
		"enabled": true
	}
}